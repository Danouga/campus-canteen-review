# Copy to .env.local. Never commit secrets or configuration backups.
PORT=4173
# file: JSON server storage; none: browser-only preview.
DB_MODE=file
DATA_DIR=./data
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=575187327@qq.com
SMTP_PASS=
# Generate a random secret and keep it stable across restarts.
AUTH_CODE_SECRET=
# Local HTTP: false. Public HTTPS: true.
AUTH_COOKIE_SECURE=false
# For a reverse proxy, list exact public origins separated by commas.
AUTH_ALLOWED_ORIGINS=https://shijian-canteen.app.workbuddy.host
